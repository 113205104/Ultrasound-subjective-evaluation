body{margin:0;background:#f3eef8;font-family:Arial,'Noto Sans TC',sans-serif;color:#111}.wrap{max-width:1050px;margin:18px auto}
.card{background:#fff;border:1px solid #ddd;border-radius:8px;box-shadow:0 1px 4px #ccc;margin:16px 8px;padding:22px}
.top{border-top:9px solid #673ab7}h1{font-weight:400;margin:10px 0 12px;font-size:32px}h2{font-weight:400}
.task{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #eee;padding:14px 0;gap:14px}
.task b{font-size:20px}
.muted{color:#666}.actions a,.button{display:inline-block;border:1px solid #ddd;border-radius:4px;padding:9px 14px;text-decoration:none;margin-left:8px;background:#fff;color:#4b2aad}button{border:1px solid #ddd;background:white;border-radius:4px;padding:10px 22px;cursor:pointer}.primary{background:#1e98f2;color:white;border-color:#1e98f2}.purple{background:#673ab7;color:white;border-color:#673ab7}.bar{height:10px;background:#e6e6e6;border-radius:8px;overflow:hidden}.bar div{height:100%;background:#673ab7;width:0}.imgbox{border:1px solid #ccc;border-radius:3px;padding:18px;text-align:center}.imgbox img{max-width:100%;max-height:430px}.nav{display:flex;justify-content:space-between;margin-top:0}.criterion{background:#fff;border:1px solid #ddd;border-radius:8px;margin:16px 8px;padding:22px}.grid{width:100%;border-collapse:collapse}.grid th,.grid td{text-align:center;padding:14px}.grid th:first-child,.grid td:first-child{text-align:left;width:170px}.choice{display:inline-block;min-width:62px;padding:8px}.choice:has(input:checked){background:#f1ebfb}.historyTable{width:100%;border-collapse:collapse;font-size:13px}.historyTable th,.historyTable td{border:1px solid #ddd;padding:6px;text-align:center}.ok{color:#138000}.warn{color:#b36b00}
@media(max-width:700px){h1{font-size:24px}.task{display:block}.actions a{margin:8px 6px 0 0}.grid th:first-child,.grid td:first-child{width:90px}}
